{
  "name": "oculis",
  "productName": "Oculis",
  "version": "0.4.0",
  "description": "A minimalist, read-only Markdown viewer. Opinionated, GitHub by default.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "bun scripts/icons.js",
    "dist": "electron-builder",
    "site": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build"
  },
  "dependencies": {
    "@pierre/highlights": "^0.3.0",
    "electron-updater": "^6.8.11",
    "github-markdown-css": "^5.9.0",
    "marked": "^18.1.2",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "pele": "^1.12.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.oculis.app",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "nsis": {
      "buildUniversalInstaller": false
    },
    "publish": {
      "provider": "github",
      "owner": "rainzee",
      "repo": "oculis",
      "vPrefixedTagName": false
    }
  }
}
